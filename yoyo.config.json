{
  "sync": {
    "include": [
      "backend/src/**/*",
      "backend/pom.xml",
      "backend/data/**/*",
      "frontend/src/**/*",
      "frontend/public/**/*",
      "frontend/package.json",
      "frontend/package-lock.json",
      "frontend/tailwind.config.js",
      "frontend/postcss.config.js",
      "frontend/tsconfig.json",
      "*.bat",
      "*.md",
      "README.md",
      ".gitignore",
      "yoyo.config.json"
    ],
    "exclude": [
      "node_modules/**/*",
      "build/**/*",
      "dist/**/*",
      ".cache/**/*",
      "target/**/*",
      "*.log",
      ".env*",
      "apache-maven-3.9.6/**/*",
      "jdk-17.0.2/**/*",
      "*.zip",
      "*.msi",
      "*.exe"
    ]
  }
}
